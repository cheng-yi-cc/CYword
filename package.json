{
  "name": "cyword",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "词根驱动的本地英语记忆桌面应用",
  "author": "CYword",
  "main": "electron/main.cjs",
  "scripts": {
    "data:verify": "node scripts/verify-book-data.mjs",
    "data:build": "npm run data:verify && node scripts/build-app-data.mjs",
    "dev": "npm run data:build && concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build:web": "tsc --noEmit && vite build",
    "build": "npm run data:build && npm run build:web",
    "dist": "npm run build && electron-builder --win nsis --publish never",
    "dist:unpacked": "npm run build && electron-builder --win dir",
    "test": "npm run data:build && node --test tests/*.test.mjs tests/*.test.ts"
  },
  "build": {
    "appId": "com.cyword.desktop",
    "productName": "词根记忆",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "data",
        "to": "data",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "CYword-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    }
  },
  "dependencies": {
    "csv-parse": "^7.0.2",
    "dompurify": "^3.4.14",
    "marked": "^18.0.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "wait-on": "^9.1.0"
  }
}
